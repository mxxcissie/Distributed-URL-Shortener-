# Environment
ENV=development

# For Docker (default)
DATABASE_URL=postgresql://postgres:postgres@db:5432/urlshortener

# For local (uncomment if running outside Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# Base URL for generated short links
BASE_URL=http://127.0.0.1:8000

# Allowed frontend origins for CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:5173,https://url-shortener-frontend-av1x.onrender.com

# Automatically create database tables on startup
AUTO_CREATE_SCHEMA=false

# App port
PORT=8000
